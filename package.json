{
  "name": "clubsphere-next",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare:pages": "node scripts/content.mjs && node scripts/generate-pages.mjs",
    "dev": "npm run prepare:pages && node scripts/dev.mjs",
    "build": "npm run prepare:pages && next build --webpack && node scripts/finalize.mjs",
    "preview": "node scripts/preview.mjs",
    "check": "node scripts/check-export.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "parse5": "^7.3.0",
    "tailwindcss": "3.4.17",
    "postcss": "^8.5.0",
    "autoprefixer": "^10.4.0"
  }
}
